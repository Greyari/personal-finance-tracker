rules_version = '2';

// =============================================================================
// Assumed Data Model
// =============================================================================
//
// Collection: /user_directory/{userId}
// Document ID: userId (matches auth.uid)
// Fields:
//   - userId: string (required, 1-128 chars, immutable)
//   - email: string (required, 1-254 chars)
//   - displayName: string (required, 0-100 chars)
//   - photoUrl: string | null (optional, <= 2000 chars)
//   - fcmToken: string | null (optional, <= 500 chars)
//   - updatedAt: timestamp (optional)
//
// Collection: /chats/{chatId}
// Document ID: chatId (sorted UIDs joined by '_', e.g. uidA_uidB)
// Fields:
//   - participantIds: list of 2 strings (required, immutable)
//   - participants: map of uid -> { userId, displayName, email, photoUrl }
//   - lastMessage: string (required, <= 2000 chars)
//   - lastMessageSenderId: string (required, <= 128 chars)
//   - lastMessageTime: timestamp (optional)
//   - unreadCount: map of uid -> int
//   - createdAt: timestamp (optional, immutable)
//   - updatedAt: timestamp (optional)
//
// Collection: /chats/{chatId}/messages/{messageId}
// Document ID: auto-generated messageId
// Fields:
//   - chatId: string (required, matches parent chatId, immutable)
//   - senderId: string (required, matches auth.uid on create, immutable)
//   - senderName: string (required, 0-100 chars)
//   - text: string (required, 0-2000 chars, editable by sender only)
//   - imageUrl: string | null (optional, <= 200000 chars, immutable)
//   - createdAt: timestamp (optional, immutable)
//   - updatedAt: timestamp (optional)
//   - isRead: bool (required)
//   - isEdited: bool (optional)
//   - type: string in ['text', 'image'] (required, immutable)
//   - reactions: map of uid -> emoji string (optional)
//
// Collection: /users/{userId}/**
// Document ID: userId (matches auth.uid)
// Subcollections:
//   - profile: /users/{userId}/profile/data
//   - categories: /users/{userId}/categories/{categoryId}
//   - transactions: /users/{userId}/transactions/{transactionId}
//   - budgets: /users/{userId}/budgets/{budgetId}
//   - saving_goals: /users/{userId}/saving_goals/{goalId}
//     - contributions: /users/{userId}/saving_goals/{goalId}/contributions/{contributionId}
//   - investments: /users/{userId}/investments/{investmentId}
//   - recurring_transactions: /users/{userId}/recurring_transactions/{recurringId}
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for shared top-level checks
    function isAuthenticated() {
      return request.auth != null;
    }

    // =========================================================================
    // User Directory: Discovery for 1-on-1 chats
    // =========================================================================
    match /user_directory/{userId} {
      function isUserDirectoryOwner() {
        return isAuthenticated() && request.auth.uid == userId;
      }

      function isValidUserDirectory(data) {
        return data.keys().hasOnly(['userId', 'email', 'displayName', 'photoUrl', 'updatedAt', 'fcmToken'])
          && data.userId == userId
          && data.email is string
          && data.email.size() > 0
          && data.email.size() <= 254
          && data.displayName is string
          && data.displayName.size() >= 0
          && data.displayName.size() <= 100
          && (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 2000))
          && (!('fcmToken' in data) || data.fcmToken == null || (data.fcmToken is string && data.fcmToken.size() <= 500))
          && (!('updatedAt' in data) || data.updatedAt is timestamp);
      }

      // Any authenticated user can read / query by email to search chat partners
      allow read: if isAuthenticated();

      // Only the profile owner can write or delete their own directory record
      allow create: if isUserDirectoryOwner()
        && request.resource.data.userId == request.auth.uid
        && isValidUserDirectory(request.resource.data);
      allow update: if isUserDirectoryOwner()
        && request.resource.data.userId == request.auth.uid
        && isValidUserDirectory(request.resource.data);
      allow delete: if isUserDirectoryOwner();
    }

    // =========================================================================
    // Direct 1-on-1 Chats and Real-Time Messages
    // =========================================================================
    match /chats/{chatId} {
      function isValidChat(data) {
        return data.keys().hasOnly([
            'participantIds', 'participants', 'lastMessage',
            'lastMessageSenderId', 'lastMessageTime', 'unreadCount',
            'createdAt', 'updatedAt'
          ])
          && data.participantIds is list
          && data.participantIds.size() == 2
          && data.lastMessage is string
          && data.lastMessage.size() <= 2000
          && data.lastMessageSenderId is string
          && data.lastMessageSenderId.size() <= 128
          && data.participants is map
          && data.unreadCount is map
          && (!('createdAt' in data) || data.createdAt is timestamp)
          && (!('updatedAt' in data) || data.updatedAt is timestamp)
          && (!('lastMessageTime' in data) || data.lastMessageTime is timestamp);
      }

      // get allows non-existent doc check during getOrCreateChatRoom without throwing permission-denied
      allow get: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participantIds);

      // list query allows watching chats where the user is a participant
      allow list: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      // Allowed on create if user is included in the 2-person participantIds list
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds
        && isValidChat(request.resource.data);

      // Allowed on update for participants, keeping participantIds and createdAt immutable
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && isValidChat(request.resource.data);

      // Chat deletion is denied to preserve audit/conversation history
      allow delete: if false;

      // -----------------------------------------------------------------------
      // Nested Messages Subcollection: /chats/{chatId}/messages/{messageId}
      // -----------------------------------------------------------------------
      match /messages/{messageId} {
        function isChatParticipant() {
          return isAuthenticated()
            && (request.auth.uid in chatId.split('_')
                || (exists(/databases/$(database)/documents/chats/$(chatId))
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds));
        }

        function isValidMessage(data) {
          return data.keys().hasOnly(['chatId', 'senderId', 'senderName', 'text', 'createdAt', 'isRead', 'type', 'imageUrl', 'reactions', 'isEdited', 'updatedAt'])
            && data.chatId == chatId
            && data.senderId is string
            && data.senderId.size() > 0
            && data.senderId.size() <= 128
            && data.senderName is string
            && data.senderName.size() >= 0
            && data.senderName.size() <= 100
            && data.text is string
            && data.text.size() >= 0
            && data.text.size() <= 2000
            && data.isRead is bool
            && data.type in ['text', 'image']
            && (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 200000))
            && (!('reactions' in data) || data.reactions is map)
            && (!('isEdited' in data) || data.isEdited is bool)
            && (!('updatedAt' in data) || data.updatedAt is timestamp)
            && (!('createdAt' in data) || data.createdAt is timestamp);
        }

        // Only participants in the parent chat room can read messages
        allow read: if isChatParticipant();

        // Must be a chat participant and senderId must match authenticated uid
        allow create: if isChatParticipant()
          && request.resource.data.senderId == request.auth.uid
          && isValidMessage(request.resource.data);

        // Participants can update message state (e.g. isRead, reactions).
        // Message text editing is strictly restricted to the original sender.
        // chatId, senderId, type, imageUrl, and createdAt remain immutable.
        allow update: if isChatParticipant()
          && request.resource.data.chatId == resource.data.chatId
          && request.resource.data.senderId == resource.data.senderId
          && (!('type' in resource.data) || request.resource.data.type == resource.data.type)
          && ((!('imageUrl' in resource.data) || resource.data.imageUrl == null)
              ? (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl == null)
              : request.resource.data.imageUrl == resource.data.imageUrl)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          && (request.resource.data.text == resource.data.text || resource.data.senderId == request.auth.uid)
          && isValidMessage(request.resource.data);

        // Only the message sender can delete their own message
        allow delete: if isChatParticipant() && resource.data.senderId == request.auth.uid;
      }
    }

    // =========================================================================
    // User-scoped data: Strictly preserved from Phase 7 audit
    // =========================================================================
    match /users/{userId} {

      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // True if `field` is unchanged between the existing document and the
      // incoming write — used to make a field immutable after creation.
      function unchanged(field) {
        return request.resource.data[field] == resource.data[field];
      }

      // Profile: exactly one document ('data') per user, holding email +
      // displayName. Matched directly rather than with a {document=**}
      // wildcard, since there is never more than this one document.
      // Email is sourced from Firebase Auth at registration and is not
      // meant to drift from it via a Firestore edit.
      match /profile/{profileDocId} {
        allow read: if isOwner();
        allow create: if isOwner()
          && request.resource.data.email is string
          && request.resource.data.displayName is string;
        allow update: if isOwner()
          && unchanged('email')
          && request.resource.data.displayName is string;
        allow delete: if isOwner();
      }

      // Categories: type is immutable after creation — changing an
      // existing category's type would silently reclassify every past
      // transaction that already references it (see CategoryModel's
      // toMapForUpdate, which never sends `type` for exactly this reason).
      match /categories/{categoryId} {
        allow read: if isOwner();
        allow create: if isOwner()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type in ['income', 'expense', 'saving', 'investment'];
        allow update: if isOwner()
          && unchanged('type')
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
        allow delete: if isOwner();
      }

      // Transactions: amount must always be > 0 (business rule 6).
      // userId is immutable once set — type/categoryId/amount/date/
      // description remain editable, matching what the edit form allows.
      match /transactions/{transactionId} {
        allow read: if isOwner();
        allow create: if isOwner()
          && request.resource.data.userId == userId
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense', 'saving', 'investment'];
        allow update: if isOwner()
          && unchanged('userId')
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense', 'saving', 'investment'];
        allow delete: if isOwner();
      }

      // Budgets: "Budget tidak boleh negatif" (value > 0), percentage
      // capped at 100, userId immutable once set.
      match /budgets/{budgetId} {
        allow read: if isOwner();
        allow create: if isOwner()
          && request.resource.data.userId == userId
          && request.resource.data.categoryId is string
          && request.resource.data.value is number
          && request.resource.data.value > 0
          && (request.resource.data.isPercentage == false || request.resource.data.value <= 100);
        allow update: if isOwner()
          && unchanged('userId')
          && request.resource.data.value is number
          && request.resource.data.value > 0
          && (request.resource.data.isPercentage == false || request.resource.data.value <= 100);
        allow delete: if isOwner();
      }

      // Saving goals: targetAmount must be positive; userId immutable.
      match /saving_goals/{goalId} {
        allow read: if isOwner();
        allow create: if isOwner()
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.targetAmount is number
          && request.resource.data.targetAmount > 0;
        allow update: if isOwner()
          && unchanged('userId')
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.targetAmount is number
          && request.resource.data.targetAmount > 0
          && request.resource.data.currentAmount is number;
        allow delete: if isOwner();

        // Contribution history: synced 1-to-1 with transactions (docId = transactionId).
        // Amount must be positive. Linked contribution docs are updated or
        // deleted when the corresponding saving transaction is edited or deleted.
        match /contributions/{contributionId} {
          allow read: if isOwner();
          allow create: if isOwner()
            && request.resource.data.amount is number
            && request.resource.data.amount > 0;
          allow update: if isOwner()
            && request.resource.data.amount is number
            && request.resource.data.amount > 0;
          allow delete: if isOwner();
        }
      }

      // Investments: manual tracking only (no broker integration, per
      // Section 12). capital must be positive so return % stays
      // well-defined; currentValue may be 0 (a total loss is valid).
      // userId immutable once set.
      match /investments/{investmentId} {
        allow read: if isOwner();
        allow create: if isOwner()
          && request.resource.data.userId == userId
          && request.resource.data.categoryId is string
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.capital is number
          && request.resource.data.capital > 0
          && request.resource.data.currentValue is number
          && request.resource.data.currentValue >= 0;
        allow update: if isOwner()
          && unchanged('userId')
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.capital is number
          && request.resource.data.capital > 0
          && request.resource.data.currentValue is number
          && request.resource.data.currentValue >= 0;
        allow delete: if isOwner();
      }

      // Recurring transactions: same nominal/percentage validation as
      // budgets, userId immutable. Transactions this config generates
      // land in /transactions (rules above), tagged with recurringId +
      // generatedPeriod for the duplicate-prevention check in
      // RecurringTransactionRepository.generateForPeriodIfNeeded.
      match /recurring_transactions/{recurringId} {
        allow read: if isOwner();
        allow create: if isOwner()
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.value is number
          && request.resource.data.value > 0
          && (request.resource.data.isPercentage == false || request.resource.data.value <= 100)
          && request.resource.data.type in ['income', 'expense', 'saving', 'investment'];
        allow update: if isOwner()
          && unchanged('userId')
          && request.resource.data.value is number
          && request.resource.data.value > 0
          && (request.resource.data.isPercentage == false || request.resource.data.value <= 100)
          && request.resource.data.type in ['income', 'expense', 'saving', 'investment'];
        allow delete: if isOwner();
      }
    }
  }
}
